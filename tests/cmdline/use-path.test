#!/bin/sh

# --use-paths: attachment paths inside the TNEF file are honoured, but
# absolute paths are made relative to the extraction directory.
#
# The .tnef files were generated with a proof-of-concept script from
# Julien Ahrens (RCE Security GmbH).

. $srcdir/../util.sh

bin=$srcdir/../../src/tnef
datadir=$srcdir/../files/datafiles
work=$srcdir/use-path.dir
extract=$work/a/b/extract

cleanup() {
    rm -rf $work
}

expect_file() {
    if [ ! -f $1 ]; then
        echo "$1 missing.  Test failed."
        find $work -type f
        cleanup
        exit 1
    fi
}

cleanup
mkdir -p $extract/docs $extract/abs

echo > $srcdir/use-path.output
echo $bin --list --use-paths use-paths.tnef >> $srcdir/use-path.output
$bin --list --use-paths $datadir/use-paths.tnef >> $srcdir/use-path.output 2>&1

$bin --use-paths -C $extract $datadir/use-paths.tnef >> $srcdir/use-path.output 2>&1
expect_file $extract/docs/report.txt
expect_file $extract/abs/absolute.txt

check_test use-path

cleanup
